DATABASE_URL=postgres://YOUR_USER@localhost:5432/jobfinder
DATABASE_URL_TEST=postgres://YOUR_USER@localhost:5432/jobfinder_test
OPENROUTER_API_KEY=
OPENROUTER_CHEAP_MODEL=nvidia/nemotron-3.5-super-vl:free,baidu/ernie-5.5-flash-preview:free,google/gemma-4-31b-it:free,deepseek/deepseek-v4.1-flash-1017
# Scoring uses OpenRouter's TypeSafe Jev Router by default (OPENROUTER_API_KEY only). Override the model here.
JEV_MODEL=typesafe/jev-router
# Optional: SCORING_PROVIDER=typesafe to call TypeSafe directly with TYPESAFE_API_KEY
SCORING_PROVIDER=
TYPESAFE_API_KEY=
JEV_USD_PER_MTOK_INPUT=0.042
JEV_USD_PER_MTOK_OUTPUT=0
# Optional: limit boards polled per cycle (testing)
MAX_BOARDS=
OPENROUTER_TOP_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_MID_MODEL=anthropic/claude-haiku-5.5

# Resume tailoring provider: codex_cli (default, ChatGPT subscription) or openrouter
RESUME_LLM_PROVIDER=codex_cli
# Explicit opt-in only — never auto-fallback on Codex failure
RESUME_OPENROUTER_FALLBACK=false
CODEX_CLI_PATH=codex
# Milliseconds
CODEX_TASK_TIMEOUT=300000
RESUME_OUTPUT_DIRECTORY=
# Optional, default data/codex-workspaces
CODEX_WORKSPACE_DIRECTORY=data/out
RESUME_TEMPLATE_PATH=resume.tex
